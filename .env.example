VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_CLIENT_ID=
# Used by Supabase Google OAuth provider; not currently read directly by the app.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Public-facing URL of the app. Used in invite links.
VITE_PUBLIC_APP_URL=https://third-state.vercel.app

# Server & maintenance scripts configuration (local/server only).
# WARNING: SUPABASE_SERVICE_ROLE_KEY must NEVER carry a VITE_ prefix,
# because a VITE_ prefix would bundle the service role key into client app builds!
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
