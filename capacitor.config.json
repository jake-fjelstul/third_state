{
  "appId": "com.thirdspace.social",
  "appName": "Third Space",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 1500,
      "backgroundColor": "#000000",
      "backgroundColorDark": "#000000",
      "showSpinner": false,
      "splashImmersive": true
    },
    "Keyboard": {
      "resize": "none"
    }
  },
  "packageClassList": [
    "SignInWithApple",
    "AppPlugin",
    "CAPBrowserPlugin",
    "HapticsPlugin",
    "KeyboardPlugin",
    "CAPNetworkPlugin",
    "PreferencesPlugin",
    "PushNotificationsPlugin",
    "SharePlugin",
    "SplashScreenPlugin",
    "StatusBarPlugin"
  ]
}
